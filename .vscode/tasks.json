{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CoinTribe: Compile backend",
			"type": "process",
			"command": "${workspaceFolder}\\backend\\mvnw.cmd",
			"args": [
				"compile",
				"-DskipTests"
			],
			"options": {
				"cwd": "${workspaceFolder}\\backend"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Maven: Run CoinTribe Backend",
			"type": "process",
			"command": "${workspaceFolder}\\backend\\mvnw.cmd",
			"args": [
				"spring-boot:run"
			],
			"options": {
				"cwd": "${workspaceFolder}\\backend"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}