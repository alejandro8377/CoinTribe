{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CoinTribe: Compile backend",
			"type": "process",
			"command": "${workspaceFolder}\\backend\\mvnw.cmd",
			"args": [
				"compile",
				"-DskipTests"
			],
			"options": {
				"cwd": "${workspaceFolder}\\backend"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "CoinTribe: Start backend",
			"type": "process",
			"command": "${workspaceFolder}\\backend\\mvnw.cmd",
			"args": [
				"spring-boot:run"
			],
			"options": {
				"cwd": "${workspaceFolder}\\backend",
				"env": {
					"PORT": "8080"
				}
			},
			"isBackground": true,
			"problemMatcher": [
				{
					"owner": "spring-boot",
					"pattern": {
						"regexp": "^\\[ERROR\\]\\s*(.*)$",
						"message": 1
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": "^.*:: Spring Boot ::.*$",
						"endsPattern": "^.*Started .* in .* seconds.*$"
					}
				}
			]
		}
	]
}