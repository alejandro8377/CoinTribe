# Copia este archivo a .env en local SOLO si usas Postgres local.
# En Render define las mismas claves en Environment.

# --- Local H2: no hace falta nada; arranca con ./mvnw spring-boot:run ---

# --- Postgres (Neon o Render) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=TU_PASSWORD_AQUI
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
PORT=8080
